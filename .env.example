# Copy to .env only for local development. Never commit a real API key.
# To enable the agent, change the provider to openai and fill both values below.
FIXTRACE_LLM_PROVIDER=disabled
FIXTRACE_LLM_MODEL=
OPENAI_API_KEY=

FIXTRACE_AGENT_MAX_STEPS=6
FIXTRACE_LLM_TIMEOUT_SECONDS=60
FIXTRACE_AGENT_MAX_TOOL_OUTPUT_CHARS=12000
FIXTRACE_ALLOW_LOCAL_SOURCES=0
FIXTRACE_ALLOW_LOCAL_EXECUTION=0
FIXTRACE_ANALYSIS_TIMEOUT_SECONDS=120
FIXTRACE_MAX_OUTPUT_BYTES=200000
FIXTRACE_WORK_ROOT=.fixtrace/workspaces
